#include <iostream>
#include <string>
using namespace std;

    bool isPalindrome(string text)
    {
        int left = 0;
        int right = text.length() - 1;

        while (left < right)
        {
            if (text[left] != text[right])
            {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }

    int main()
    {
        cout << isPalindrome("racecar") << "\n"; // 1 (true)
        cout << isPalindrome("hello") << "\n";   // 0 (false)
    }

